# OneAgent Configuration
# Copy to .env and fill in your keys

# === AI Providers ===
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AI...
OLLAMA_HOST=http://localhost:11434

# === Healthcare IT ===
FHIR_BASE_URL=http://hapi.fhir.org/baseR4
FHIR_AUTH_TOKEN=
CUREMD_PORTAL_URL=https://api.curemd.com
CUREMD_API_KEY=

# === Microsoft 365 ===
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=
TEAMS_CLIENT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_SITE_ID=

# === Database ===
DATABASE_URL=sqlite:///data/superapp.db
REDIS_URL=redis://localhost:6379

# === GitHub ===
GITHUB_TOKEN=ghp_...

# === App Settings ===
WORKSPACE_DIR=./workspace
LOG_LEVEL=INFO

# === Budget ===
LLM_DAILY_BUDGET_USD=5.0
LLM_MAX_TOKENS=4096

# === Security ===
SECRET_KEY=change-me-in-production
