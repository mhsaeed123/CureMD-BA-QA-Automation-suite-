# CureMD BA QA Automation Suite - Environment Variables
# Copy this to .env and fill in your values

# =============================================================================
# API KEYS
# =============================================================================

# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google API Key (for Gemini)
GOOGLE_API_KEY=your-google-api-key-here

# GitHub Token (for Git operations)
GITHUB_TOKEN=your-github-token-here


# =============================================================================
# DATABASE
# =============================================================================

# SQLite database (default)
DATABASE_URL=sqlite:///./data/superapp.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/superapp

# Redis (for caching/celery)
REDIS_URL=redis://localhost:6379


# =============================================================================
# LLM ENDPOINTS
# =============================================================================

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434

# LM Studio (local LLM)
LM_STUDIO_URL=http://localhost:1234


# =============================================================================
# SECURITY
# =============================================================================

# Secret key for JWT tokens (change in production!)
SECRET_KEY=change-me-to-a-random-secret-key-in-production

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1


# =============================================================================
# PATHS
# =============================================================================

# Working directory for file operations
WORKSPACE_DIR=./workspace

# Upload directory
UPLOAD_DIR=./uploads


# =============================================================================
# HEALTHCARE IT (Optional)
# =============================================================================

# FHIR Server URL
FHIR_BASE_URL=http://localhost:8080/fhir

# Epic EHR Integration (optional)
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
